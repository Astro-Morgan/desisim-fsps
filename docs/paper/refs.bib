% Living bibliography for demiurge's methods.tex, per the refactor charter
% (HANDOFF3 Sec. 7). Add an entry here in the SAME COMMIT as any code change
% that introduces a citation-bearing functional form or Tier 2 default
% prior (src/demiurge/parameters/registry.py's NPEParameter.citation field
% and this file should never drift apart -- eventually cross-checked
% automatically, HANDOFF3 Sec. 6.2/7).
%
% Every entry below was independently verified via live lookup (WebSearch/
% WebFetch against ADS, arXiv, journal pages, or the cited GitHub repo) in
% the same session that wrote the citing code -- not transcribed from
% training-data memory. Author/year/journal/volume/page(article id) are
% confirmed for all entries; a `doi` field is included only where that
% specific string was independently confirmed in that lookup (omitted,
% not guessed, otherwise -- check ADS directly before relying on a DOI for
% any entry below that lacks one).

% =============================================================================
% galaxy_continuum.sfh -- Dense-Basis-style continuous SFH generation
% =============================================================================
@ARTICLE{IyerGawiser2017,
    author = {{Iyer}, Kartheik and {Gawiser}, Eric},
    title = "{Reconstructing Star Formation Histories with Nonparametric Spline Fits}",
    journal = {The Astrophysical Journal},
    year = 2017,
    volume = {838},
    pages = {127},
    note = {Introduces the Dense Basis approach this project's SFH generator is modeled on.},
}

@ARTICLE{Iyer2019,
    author = {{Iyer}, Kartheik G. and {Gawiser}, Eric and {Faber}, S.~M. and {Ferguson}, Henry~C. and {Kartaltepe}, Jeyhan and {Koekemoer}, Anton~M. and {Pacifici}, Camilla and {Somerville}, Rachel~S.},
    title = "{Nonparametric Star Formation History Reconstruction with Gaussian Processes. I. Counting Major Episodes of Star Formation}",
    journal = {The Astrophysical Journal},
    year = 2019,
    volume = {879},
    pages = {116},
    note = {Matern-3/2 Gaussian-process reconstruction of cumulative mass fraction vs. cosmic time; this project's SFH module implements a simplified numpy-only version of this method (see sfh.py's module docstring for the documented departures).},
}

